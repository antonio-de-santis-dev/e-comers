<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <!--
      Added the entity RigaOrdine.
  -->
  <changeSet id="20260318101356-1" author="jhipster">
    <createTable tableName="riga_ordine">
      <column name="id" type="${uuidType}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="prodotto_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <column name="nome_prodotto" type="varchar(255)">
        <constraints nullable="false" />
      </column>
      <column name="prezzo_unitario" type="decimal(21,2)">
        <constraints nullable="false" />
      </column>
      <column name="quantita" type="integer">
        <constraints nullable="false" />
      </column>
      <column name="prezzo_totale" type="decimal(21,2)">
        <constraints nullable="false" />
      </column>
      <column name="aliquota_iva" type="decimal(21,2)">
        <constraints nullable="false" />
      </column>
      <column name="ordine_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
    </createTable>
  </changeSet>

  <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

  <changeSet id="20260318101356-1-data" author="jhipster" context="faker">
    <loadData
      file="config/liquibase/fake-data/riga_ordine.csv"
      separator=";"
      tableName="riga_ordine"
      usePreparedStatements="true">
      <column name="id" type="${uuidType}"/>
      <column name="prodotto_id" type="${uuidType}"/>
      <column name="nome_prodotto" type="string"/>
      <column name="prezzo_unitario" type="numeric"/>
      <column name="quantita" type="numeric"/>
      <column name="prezzo_totale" type="numeric"/>
      <column name="aliquota_iva" type="numeric"/>
      <column name="ordine_id" type="${uuidType}"/>
    </loadData>
  </changeSet>
</databaseChangeLog>
