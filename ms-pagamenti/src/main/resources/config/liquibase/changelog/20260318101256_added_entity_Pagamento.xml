<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="20260318101256-1" author="jhipster">
    <createTable tableName="pagamento">
      <column name="id" type="${uuidType}">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="ordine_id" type="${uuidType}">
        <constraints nullable="false" />
      </column>
      <column name="metodo_pagamento" type="varchar(255)">
        <constraints nullable="false" />
      </column>
      <column name="importo" type="decimal(21,2)">
        <constraints nullable="false" />
      </column>
      <column name="stato" type="varchar(255)">
        <constraints nullable="false" />
      </column>
      <column name="transazione_id" type="varchar(255)">
        <constraints nullable="true" />
      </column>
      <column name="data_operazione" type="${datetimeType}">
        <constraints nullable="false" />
      </column>
    </createTable>
    <dropDefaultValue tableName="pagamento" columnName="data_operazione" columnDataType="${datetimeType}"/>
  </changeSet>

  <changeSet id="20260318101256-1-data" author="jhipster" context="faker">
    <loadData
      file="config/liquibase/fake-data/pagamento.csv"
      separator=";"
      tableName="pagamento"
      usePreparedStatements="true">
      <column name="id" type="${uuidType}"/>
      <column name="ordine_id" type="${uuidType}"/>
      <column name="metodo_pagamento" type="string"/>
      <column name="importo" type="numeric"/>
      <column name="stato" type="string"/>
      <column name="transazione_id" type="string"/>
      <column name="data_operazione" type="date"/>
    </loadData>
  </changeSet>
</databaseChangeLog>
